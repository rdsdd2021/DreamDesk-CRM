# ==========================================
# DreamDesk CRM - Production Environment Configuration
# ==========================================

# Node environment (production / development)
NODE_ENV=production

# Server Port
PORT=3000

# Persistent Data Storage Path (defaults to ./data/crm.db)
# Mount a persistent volume at this path in Docker or Cloud VMs
DATABASE_DIR=/app/data
DATABASE_PATH=/app/data/crm.db

# Optional Session Configuration
SESSION_EXPIRY_DAYS=7
