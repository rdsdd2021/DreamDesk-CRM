{
  "expo": {
    "name": "DreamDesk CRM",
    "slug": "dreamdesk-crm",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assistt.dreamdesk.mobile"
    },
    "android": {
      "package": "com.assistt.dreamdesk.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "READ_PHONE_STATE",
        "CALL_PHONE",
        "POST_NOTIFICATIONS",
        "ACCESS_NETWORK_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4f46e5"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "39985afe-050e-4571-a4f3-7d70b97169c8"
      }
    }
  }
}
